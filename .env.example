# Resend — used by both api/contact.js and api/audit-request.js
RESEND_API_KEY=

# Supabase — used by api/audit-request.js, api/audit-report.js, and
# api/report/edit.js. SUPABASE_SECRET_KEY is the server-side secret key
# (Supabase's current "sb_secret_..." format, same role the legacy service
# role key played) — never exposed to the frontend, this table/bucket has no
# public RLS policies. SUPABASE_PUBLISHABLE_KEY/SUPABASE_JWKS_URL are stored
# for completeness but currently unused — nothing in this codebase talks to
# Supabase from the browser or verifies Supabase Auth JWTs yet.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_JWKS_URL=
AUDIT_REPORTS_BUCKET=audit-reports

# api/report/edit.js — dedicated credential (NOT the Supabase secret key
# above) required as the `x-api-key` header on every call to that endpoint,
# so report-editing access can be rotated/revoked on its own. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
REPORT_EDIT_API_KEY=

# Google OAuth (GA4 + GTM readonly, sensitive-tier scopes) — used by
# api/oauth/google/{authorize,callback}.js. GOOGLE_OAUTH_CLIENT_SECRET is
# server-side only, never exposed to the frontend. Project: optimizers-tools-ga4.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Must exactly match one of the Authorized redirect URIs on the GCP OAuth
# client — http://localhost:5173/api/oauth/google/callback for local dev,
# https://www.optimizers.agency/api/oauth/google/callback for production.
GOOGLE_OAUTH_REDIRECT_URI=

# Frontend build-time flag — shows the "Connect Google" button in the audit
# form. Keep false/unset until Google's verification actually clears; true
# while unverified means every visitor sees Google's "unverified app"
# warning screen mid-consent.
VITE_GOOGLE_OAUTH_ENABLED=false
