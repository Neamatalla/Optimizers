# --- Queue (shared with the Vercel capture endpoint) ---
# SUPABASE_SECRET_KEY is Supabase's current server-side secret key format
# ("sb_secret_..."), same role the legacy service role key played.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# --- Delivery ---
RESEND_API_KEY=
# Production default is https://optimizers.agency. For a LOCAL poll.ts run
# against the real Supabase queue, set this to http://localhost:5173 instead
# (or wherever the root project's dev server runs) so the emailed link is
# actually servable — the root vite.config.ts's /audit-reports dev middleware
# mirrors api/audit-report.js (Supabase Storage download by slug).
PUBLIC_SITE_URL=https://optimizers.agency
AUDIT_REPORTS_BUCKET=audit-reports

# --- GA4, via the operator's existing service-account-backed MCP server ---
# Local script path (see: C:\Users\<you>\ga4-admin-mcp\src\index.mjs on the
# machine this was first verified on). Copy that project + its SA key file to
# wherever this worker runs (laptop now, VPS later) and update the path below.
GA4_ADMIN_MCP_SCRIPT_PATH=
GA4_SA_KEY_PATH=

# --- GTM, via the operator's existing service-account-backed MCP server ---
GTM_MCP_SCRIPT_PATH=
GTM_SERVICE_ACCOUNT_PATH=

# --- Clarity, via the operator's existing local Clarity MCP script ---
# Same script used for existing per-client setups (e.g. a "clarity-balqees"
# style config) — this worker launches it fresh per job with each visitor's
# own pasted token instead of one fixed client's token.
CLARITY_MCP_SCRIPT_PATH=

# --- claude -p ---
# Path to the claude binary if it's not on PATH for the account/service this
# runs under (systemd services on a VPS often need an absolute path).
CLAUDE_BIN=claude
CLAUDE_REPORT_TIMEOUT_MS=300000

# How often the poll loop checks for new pending rows, in milliseconds.
POLL_INTERVAL_MS=60000

# --- Internal review / delayed client send ---
# Every completed audit is emailed here for review first — never straight to
# the requester. See poll.ts's processRequest tail + api/_lib/audit-approve.js.
AUDIT_REVIEWER_EMAIL=omar@optimizers.agency
# UTC hour after which the once-per-day due-dates digest is sent to
# AUDIT_REVIEWER_EMAIL (see poll.ts's maybeSendDailyDigest). Default 20 is
# roughly end-of-day for a Cairo-based reviewer (UTC+2/+3).
DAILY_DIGEST_HOUR_UTC=20
