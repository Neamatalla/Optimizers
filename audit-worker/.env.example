# --- Queue (shared with the Vercel capture endpoint) ---
# SUPABASE_SECRET_KEY is Supabase's current server-side secret key format
# ("sb_secret_..."), same role the legacy service role key played.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# --- Delivery ---
RESEND_API_KEY=
# Production default is https://optimizers.agency. For a LOCAL poll.ts run
# against the real Supabase queue, set this to http://localhost:5173 instead
# (or wherever the root project's dev server runs) so the emailed link is
# actually servable — the root vite.config.ts's /audit-reports dev middleware
# mirrors api/audit-report.js (Supabase Storage download by slug).
PUBLIC_SITE_URL=https://optimizers.agency
AUDIT_REPORTS_BUCKET=audit-reports

# Where test-mode reports go instead (a submission whose email AND website
# were both typed with a leading "-" — see api/_lib/audit-intake.js — plus
# anything published by npm run test-run). Separate bucket so throwaway
# reports never sit alongside real client ones; create it via
# supabase/schema.sql, same as the main bucket.
AUDIT_REPORTS_TEST_BUCKET=audit-reports-test

# --- GA4, via the operator's existing service-account-backed MCP server ---
# Local script path (see: C:\Users\<you>\ga4-admin-mcp\src\index.mjs on the
# machine this was first verified on). Copy that project + its SA key file to
# wherever this worker runs (laptop now, VPS later) and update the path below.
GA4_ADMIN_MCP_SCRIPT_PATH=
GA4_SA_KEY_PATH=

# --- GTM, via the operator's existing service-account-backed MCP server ---
GTM_MCP_SCRIPT_PATH=
GTM_SERVICE_ACCOUNT_PATH=

# --- claude -p ---
# Path to the claude binary if it's not on PATH for the account/service this
# runs under (systemd services on a VPS often need an absolute path).
CLAUDE_BIN=claude
# Hard ceiling for a single claude -p run, in milliseconds. Optional —
# leave unset and the worker picks by route: 35min when the run drives a
# headless browser (the visitor picked one or neither of GA4/GTM) and 20min
# when it is API-only (they picked both). Set this only to override those,
# e.g. on a slower machine.
#
# NOTE: this replaces CLAUDE_REPORT_TIMEOUT_MS, which was documented here
# but never actually read by any code — setting it did nothing.
CLAUDE_TIMEOUT_MS=

# Where Chrome/Chromium lives, for the device-framed site mockup in the
# report (screenshots.ts). Optional — the worker checks the usual install
# paths per platform plus the Chrome-for-Testing cache first. Set it only if
# the browser is somewhere unusual. With no browser at all the audit still
# runs and the report simply omits the mockup.
CHROME_PATH=

# How often the poll loop checks for new pending rows, in milliseconds.
POLL_INTERVAL_MS=60000

# --- Internal review / delayed client send ---
# Every completed audit is emailed here for review first — never straight to
# the requester. See poll.ts's processRequest tail + api/_lib/audit-approve.js.
# The Vercel side reads the SAME variable (api/_lib/audit-intake.js's
# auditNotifyEmail) for the "new audit request" notification, so set it in
# the Vercel project env too — otherwise that one falls back to the default
# below while the worker uses whatever is set here, and the two notifications
# end up going to different people. Note this is NOT the contact/book-a-
# meeting recipient; api/contact.js has its own, deliberately different.
AUDIT_REVIEWER_EMAIL=omar@optimizers.agency

# Second internal recipient, notified at REQUEST time only (never by this
# worker): a two-line heads-up with just the requester's email and website,
# none of the reviewer's operational detail. Read by
# api/_lib/audit-intake.js's auditHeadsUpEmail on the Vercel side, so set it
# there for production; listed here so both halves of the system's config
# are documented in one place. Skipped entirely for test-mode runs.
AUDIT_HEADSUP_EMAIL=mohamed@neamatalla.com
# UTC hour after which the once-per-day due-dates digest is sent to
# AUDIT_REVIEWER_EMAIL (see poll.ts's maybeSendDailyDigest). Default 20 is
# roughly end-of-day for a Cairo-based reviewer (UTC+2/+3).
DAILY_DIGEST_HOUR_UTC=20
