{
  "name": "audit-worker",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Headless worker that claims 'Get a Free Audit' requests from Supabase and processes them via `claude -p`. Not built by Vite, not deployed to Vercel — runs as a Docker container (Railway in production; see Dockerfile and README).",
  "scripts": {
    "poll": "tsx src/poll.ts",
    "test-run": "tsx src/test-run.ts",
    "test-run-oauth": "tsx src/test-run-oauth.ts",
    "test-send-review-email": "tsx src/test-send-review-email.ts",
    "test-send-digest-email": "tsx src/test-send-digest-email.ts",
    "preview-report": "tsx src/preview-report.ts",
    "requeue": "tsx src/requeue.ts",
    "seed-checklist": "tsx src/seed-checklist.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/poll.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.4",
    "chrome-devtools-mcp": "1.10.1",
    "dotenv": "^16.4.5",
    "puppeteer-core": "^23.11.1",
    "resend": "^6.9.2"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsx": "^4.19.0",
    "typescript": "^5.9.3"
  }
}
