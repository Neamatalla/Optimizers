# systemd unit for the audit worker. Install steps are in ../README.md
# ("Production (server)"). Adjust User and WorkingDirectory to your server.
#
#   sudo cp deploy/audit-worker.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now audit-worker
#   journalctl -u audit-worker -f

[Unit]
Description=Optimizers audit worker (Get a Free Audit queue)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=auditworker
WorkingDirectory=/opt/optimizers/audit-worker
# .env in WorkingDirectory is loaded by the worker itself (dotenv).
ExecStart=/usr/bin/node dist/poll.js
Environment=NODE_ENV=production
# Restart on crash. A job it was running is not lost: its lease expires after
# 10 minutes and the restarted worker resumes it from the last saved stage.
Restart=always
RestartSec=10
# On stop/deploy the worker finishes its current job before exiting (SIGTERM
# is handled in poll.ts). Audits can take a while, so allow up to 20 minutes
# before systemd force-kills it; even a force-kill only delays the job, it
# resumes on the next start.
KillSignal=SIGTERM
TimeoutStopSec=1200
# Chrome (screenshots, browser checks) needs a writable HOME for its profile,
# and claude -p reads its login from the same HOME.
Environment=HOME=/home/auditworker

[Install]
WantedBy=multi-user.target
